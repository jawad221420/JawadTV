<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/red" />
            <stroke android:width="1dp" android:color="@color/red_ring" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#66E0243C" />
            <stroke android:width="1dp" android:color="@color/red_soft" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
