<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/red" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#1E1416" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
            <corners android:topRightRadius="14dp" android:bottomRightRadius="14dp" android:topLeftRadius="0dp" android:bottomLeftRadius="0dp" />
        </shape>
    </item>
</layer-list>
