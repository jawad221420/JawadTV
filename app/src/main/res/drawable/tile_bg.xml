<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#40E0243C" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_focus" />
                    <stroke android:width="2dp" android:color="@color/red_ring" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass" />
                    <stroke android:width="1dp" android:color="@color/glass_border" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
